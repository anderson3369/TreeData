<resources>
    <!-- Base application theme (Dark) -->
    <style name="Theme.TreeData.ChatGPT" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#66BB6A</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#A1887F</item>
        <item name="colorAccent">#A1887F</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">#E3E3DC</item>
        <item name="android:textColorSecondary">@color/grey</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/colorBackgroundDark</item>
        <item name="android:statusBarColor">@color/colorBackgroundDark</item>

        <!-- Drawer item styling -->
        <item name="android:itemBackground">@color/colorSurfaceDark</item>
    </style>

    <style name="Theme.TreeData.ChatGPT.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="App.ToolbarStyle" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
    </style>

    <style name="AgEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/rounded_edittext_background</item>
    </style>

    <style name="DatePicker" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">#66BB6A</item>
        <item name="colorAccent">#66BB6A</item>
        <!-- Explicitly set button style to avoid white-on-white text issues from AgButton -->
        <item name="android:buttonBarButtonStyle">@style/DatePicker.ButtonBarButtonStyle</item>
    </style>

    <style name="DatePicker.ButtonBarButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#66BB6A</item>
    </style>

    <style name="SpinnerDatePicker" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">#66BB6A</item>
        <item name="colorAccent">#66BB6A</item>
        <item name="android:datePickerStyle">@style/SpinnerDatePickerStyleDark</item>
    </style>

    <style name="SpinnerDatePickerStyleDark" parent="android:Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
    </style>

    <style name="AgButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.TreeData.ChatGPT.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

</resources>
