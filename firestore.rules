rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in can read/write farms they have access to.
    // For Phase 2 (single-user write-through) this is enough.
    // Tighten in Phase 4 when you add sharing/membership.
    match /farms/{siteId} {
      allow read, write: if request.auth != null;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}